# ── Database ───────────────────────────────────
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome_secret
POSTGRES_DB=smart_home_db

# ── Server ─────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── JWT ────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ───────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── MQTT ───────────────────────────────────────
MQTT_BROKER=nfa1412a.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_BROKER_URL=mqtts://nfa1412a.ala.asia-southeast1.emqxsl.com:8883
MQTT_USERNAME=mqttx_PTUD
MQTT_PASSWORD=123456789
MQTT_DATA_TOPIC=TN/IOT/smarthome/tt
MQTT_CMD_TOPIC=TN/IOT/smarthome/cmd/led
MQTT_RECONNECT_PERIOD=5000
MQTT_CONNECT_TIMEOUT=30000

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# ── Logging ────────────────────────────────────
LOG_LEVEL=info

# ── Electricity Price (VND/kWh) ────────────────
ELECTRICITY_PRICE=3000
