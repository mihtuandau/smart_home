generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  GUEST
}

enum DeviceStatus {
  ON
  OFF
}

// User management
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String    @unique
  password  String
  role      UserRole  @default(USER)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  devices      Device[]
  activityLogs ActivityLog[]
  notificationSettings UserNotificationSettings?

  @@map("users")
}

model UserNotificationSettings {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailAlerts       Boolean @default(true)
  pushNotifications Boolean @default(true)
  deviceAlerts      Boolean @default(true)
  systemAlerts      Boolean @default(true)
  energyAlerts      Boolean @default(true)
  dailyReport       Boolean @default(true)

  quietHoursFrom String @default("22:00")
  quietHoursTo   String @default("06:00")
  emailFrequency String @default("real-time")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_notification_settings")
}

// Simplified Device management
model Device {
  id               String       @id @default(cuid())
  name             String
  pin              Int          // GPIO pin on ESP32
  status           DeviceStatus @default(OFF)
  powerConsumption Float        @default(0) // Watts (entered by user)
  manualMode       Boolean      @default(true)
  lastActive       DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]

  @@unique([userId, name])
  @@map("devices")
}

// Sensor data (Simplified)
model SensorData {
  id String @id @default(cuid())

  // AHT20 + BMP280
  temperature Float // Celsius
  humidity    Float // Percentage
  pressure    Float // hPa

  // Rain sensor (LM393)
  isRaining Boolean

  timestamp DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  @@index([timestamp])
  @@index([expiresAt])
  @@map("sensor_data")
}

// Sensor aggregates (5-minute buckets)
model SensorAgg {
  id String @id @default(cuid())

  bucketStart   DateTime
  bucketMinutes Int      @default(5)

  temperatureAvg Float
  temperatureMin Float
  temperatureMax Float

  humidityAvg Float
  humidityMin Float
  humidityMax Float

  pressureAvg Float
  pressureMin Float
  pressureMax Float

  rainCount Int @default(0)
  samples   Int

  @@unique([bucketStart, bucketMinutes])
  @@index([bucketStart])
  @@map("sensor_aggs")
}

// Power monitoring (INA219 DC) - Fixed Units
model PowerData {
  id String @id @default(cuid())

  voltage Float // Volts
  current Float // mA (as sent by INA219)
  power   Float // mW (as sent by INA219)

  timestamp DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  @@index([timestamp])
  @@index([expiresAt])
  @@map("power_data")
}

// Power aggregates (5-minute buckets)
model PowerAgg {
  id String @id @default(cuid())

  bucketStart   DateTime
  bucketMinutes Int      @default(5)

  voltageAvg Float
  voltageMin Float
  voltageMax Float

  currentAvg Float // mA
  currentMin Float // mA
  currentMax Float // mA

  powerAvg Float // mW
  powerMin Float // mW
  powerMax Float // mW

  samples Int

  @@unique([bucketStart, bucketMinutes])
  @@index([bucketStart])
  @@map("power_aggs")
}

// Activity Log
model ActivityLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  details   Json?
  ipAddress String?
  userAgent String?

  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("activity_logs")
}

// Simplified System Settings
model SystemSettings {
  id String @id @default(cuid())

  // Rain protection (The only automation currently supported by ESP32 logic)
  autoRainProtection    Boolean @default(true)
  rainHumidityThreshold Float   @default(80)

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// Persist daily LED consumption and routine patterns
model AiLearningData {
  id    String @id @default(cuid())
  date  String @unique // Format: YYYY-MM-DD
  
  led1_wh         Float @default(0)
  led2_wh         Float @default(0)
  led1_on_minutes Float @default(0)
  led2_on_minutes Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_learning_data")
}
