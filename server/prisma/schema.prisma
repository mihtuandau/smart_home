generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  GUEST
}

enum DeviceStatus {
  ON
  OFF
  AUTO
}

enum DeviceType {
  LED
  FAN
  AC
  PUMP
  OTHER
  TOUCH
  SERVO
}

enum PowerSource {
  SOLAR
  GRID
  BATTERY
}

// User management
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String    @unique
  password  String
  role      UserRole  @default(USER)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  devices      Device[]
  activityLogs ActivityLog[]
  notificationSettings UserNotificationSettings?

  @@map("users")
}

model UserNotificationSettings {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailAlerts       Boolean @default(true)
  pushNotifications Boolean @default(true)
  deviceAlerts      Boolean @default(true)
  systemAlerts      Boolean @default(true)
  energyAlerts      Boolean @default(true)
  dailyReport       Boolean @default(true)

  quietHoursFrom String @default("22:00")
  quietHoursTo   String @default("06:00")
  emailFrequency String @default("real-time")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_notification_settings")
}

// Device management
model Device {
  id               String       @id @default(cuid())
  name             String
  type             DeviceType   @default(LED)
  pin              Int          // GPIO pin on ESP32
  status           DeviceStatus @default(OFF)
  value            Int          @default(0) // Brightness or state 0-100
  powerConsumption Float        @default(0) // Watts
  manualMode       Boolean      @default(true)
  lastActive       DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Sub-device metadata
  led   Led?
  servo Servo?
  touch Touch?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]

  @@unique([userId, name])
  @@map("devices")
}

model Led {
  id            String @id @default(cuid())
  deviceId      String @unique
  device        Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  color         String @default("#FFFFFF")
  brightness    Int    @default(100)
  minBrightness Int    @default(0)
  maxBrightness Int    @default(100)

  @@map("device_led_meta")
}

model Servo {
  id       String @id @default(cuid())
  deviceId String @unique
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  angle    Int    @default(0)
  minAngle Int    @default(0)
  maxAngle Int    @default(180)

  @@map("device_servo_meta")
}

model Touch {
  id        String @id @default(cuid())
  deviceId  String @unique
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  sensitivity Int @default(50)

  @@map("device_touch_meta")
}

// Sensor data
model SensorData {
  id String @id @default(cuid())

  temperature Float // Celsius
  humidity    Float // Percentage
  pressure    Float // hPa
  lightLevel  Float @default(0)
  isDark      Boolean @default(false)
  isRaining   Boolean

  timestamp DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  @@index([timestamp])
  @@index([expiresAt])
  @@map("sensor_data")
}

// Sensor aggregates
model SensorAgg {
  id String @id @default(cuid())

  bucketStart   DateTime
  bucketMinutes Int      @default(5)

  temperatureAvg Float
  temperatureMin Float
  temperatureMax Float

  humidityAvg Float
  humidityMin Float
  humidityMax Float

  pressureAvg Float
  pressureMin Float
  pressureMax Float

  lightLevelAvg Float @default(0)
  lightLevelMin Float @default(0)
  lightLevelMax Float @default(0)
  darkCount     Int @default(0)

  rainCount Int @default(0)
  samples   Int

  @@unique([bucketStart, bucketMinutes])
  @@index([bucketStart])
  @@map("sensor_aggs")
}

// Power monitoring
model PowerData {
  id String @id @default(cuid())

  voltage      Float // Volts
  current      Float // mA
  power        Float // mW
  energy       Float @default(0) // Wh
  batteryLevel Float? // % (Optional to allow null)
  source       PowerSource @default(GRID)

  timestamp DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  @@index([timestamp])
  @@index([expiresAt])
  @@map("power_data")
}

// Power aggregates
model PowerAgg {
  id String @id @default(cuid())

  bucketStart   DateTime
  bucketMinutes Int      @default(5)

  voltageAvg Float
  voltageMin Float
  voltageMax Float

  currentAvg Float // mA
  currentMin Float // mA
  currentMax Float // mA

  powerAvg Float // mW
  powerMin Float // mW
  powerMax Float // mW
  
  energySum Float @default(0)

  samples Int

  @@unique([bucketStart, bucketMinutes])
  @@index([bucketStart])
  @@map("power_aggs")
}

// Activity Log
model ActivityLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  details   Json?
  ipAddress String?
  userAgent String?

  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("activity_logs")
}

// System Settings
model SystemSettings {
  id String @id @default(cuid())

  autoRainProtection    Boolean @default(true)
  rainHumidityThreshold Float   @default(80)
  autoLightEnabled      Boolean @default(true)
  lightOnTime           String  @default("18:00")
  lightOffTime          String  @default("06:00")
  lightThreshold        Float   @default(30)
  powerSaveMode         Boolean @default(false)

  // Energy & AI Settings
  energyPriceKwh      Float   @default(2500)
  powerAlertThreshold Float   @default(2000)
  maxPowerConsumption Float   @default(2000) 
  aiAdvisorEnabled    Boolean @default(true)
  aiLearningEnabled   Boolean @default(true)
  predictionHorizon   Int     @default(24)

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// AI Learning & Statistics
model AiLearningData {
  id      String @id @default(cuid())
  date    String? // Made optional to fix build errors
  feature String @default("daily_stats")
  
  // Storage for various AI outputs
  led1_wh         Float @default(0)
  led2_wh         Float @default(0)
  led1_on_minutes Float @default(0)
  led2_on_minutes Float @default(0)
  
  accuracy        Float?
  inputData       Json?
  outputData      Json?
  timestamp       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, feature])
  @@index([feature, timestamp])
  @@map("ai_learning_data")
}

model SolarData {
  id String @id @default(cuid())

  voltage Float
  current Float
  power   Float

  timestamp DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  @@index([timestamp])
  @@map("solar_data")
}
