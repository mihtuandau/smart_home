# Database Configuration
DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5432/smart_home?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DB="smart_home"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-key"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Configuration
PORT=3001
NODE_ENV="development"
HOST="0.0.0.0"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
CORS_CREDENTIALS="true"

# MQTT Configuration
MQTT_BROKER="your-mqtt-broker-url"
MQTT_PORT=8883
MQTT_BROKER_URL="mqtts://your-mqtt-broker-url:8883"
MQTT_USERNAME="your-mqtt-username"
MQTT_PASSWORD="your-mqtt-password"

# MQTT Topics
MQTT_DATA_TOPIC="TN/IOT/smarthome/tt"
MQTT_CMD_TOPIC="TN/IOT/smarthome/cmd/led"
MQTT_CMD_DEVICE_ADD="TN/IOT/smarthome/cmd/device/add"
MQTT_CMD_DEVICE_CONTROL="TN/IOT/smarthome/cmd/device/control"
MQTT_CMD_DEVICE_UPDATE="TN/IOT/smarthome/cmd/device/update"
MQTT_CMD_DEVICE_DELETE="TN/IOT/smarthome/cmd/device/delete"

MQTT_RECONNECT_PERIOD=5000
MQTT_CONNECT_TIMEOUT=30000

# WebSocket Configuration
WS_PORT=3001
WS_PATH="/socket.io"

# Rate Limiting
RATE_LIMIT_WINDOW="15m"
RATE_LIMIT_MAX="100"

# Logging
LOG_LEVEL="debug"

# Email Notification (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-app-password"
SMTP_FROM="Smart Home <your-email@example.com>"
APP_NAME="Smart Home"
ALERT_EXTRA_RECIPIENTS=""
ALERT_COOLDOWN_SECONDS=1800
DEVICE_STATE_CHANGE_EMAIL_ENABLED=false
DEVICE_STATE_ALERT_COOLDOWN_SECONDS=0
ENERGY_ALERT_COOLDOWN_SECONDS=1800
ENERGY_ALERT_DELTA_W=20
SYSTEM_ALERT_COOLDOWN_SECONDS=600
DEVICE_OFFLINE_ALERT_COOLDOWN_SECONDS=600
SYSTEM_RECOVERY_ALERT_COOLDOWN_SECONDS=0

# Maintenance alert thresholds
DEVICE_OFFLINE_MINUTES=30
SENSOR_STALE_MINUTES=20
TEMPERATURE_HIGH_C=35
TEMPERATURE_LOW_C=15
HUMIDITY_HIGH_PERCENT=85
HUMIDITY_LOW_PERCENT=30
PRESSURE_LOW_HPA=980
PRESSURE_HIGH_HPA=1035
